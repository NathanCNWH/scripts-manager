{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口和托盘菜单的基础权限",
  "windows": [
    "main",
    "traymenu"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-hide",
    "dialog:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
